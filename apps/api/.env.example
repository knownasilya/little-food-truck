PORT=8787

# The web app's own origin. Used for CORS (only this origin, plus the Tauri
# mobile origins, may call the API with credentials) and as the redirect
# target for the /t/:id truck share pages (see routes/share.ts) — set this
# to the real deployed web app URL before shipping.
WEB_ORIGIN=http://localhost:5173

# Database, Auth, and Storage all run on Supabase — see the "Local Supabase"
# section in the README for how to start/stop the local stack and where
# these specific values come from. They're the Supabase CLI's fixed local
# dev demo keys, not real secrets; a real deployment needs its own project's
# values from supabase.com (Settings -> API / Database).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Web Push (generate your own with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@example.com

# Password-reset email (see apps/api/src/lib/email.ts). In dev/test, email
# always sends through local MailDev (SMTP_HOST/SMTP_PORT below) — run
# `pnpm dev:mail` to start it and view caught mail at http://localhost:1080.
# No API key needed locally. RESEND_API_KEY only matters in production:
# without it there, forgot-password safely no-ops (see the comment in
# routes/auth.ts) instead of sending real mail. Get a key at
# https://resend.com — the default RESEND_FROM_EMAIL below is Resend's own
# shared testing sender, which works immediately with any API key and no
# domain verification; swap it for an address on a domain you've verified in
# Resend before sending real production mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SMTP_HOST=localhost
SMTP_PORT=1025
