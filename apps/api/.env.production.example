NODE_ENV=production
PORT=8787

# The web app's own real, deployed origin — used for CORS and as the
# redirect target for share pages / claim-request emails. Not localhost.
WEB_ORIGIN=https://your-real-domain.example

# From your production Supabase project's dashboard: Settings -> Database
# for DATABASE_URL (use the "connection pooling" string if offered — the
# direct one can run out of connections under normal traffic), Settings ->
# API for SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_JWT_SECRET.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security — never commit it,
# never expose it to a client.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Web Push (generate your own with `npx web-push generate-vapid-keys`) —
# optional, but notifications silently don't work without it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-real-domain.example

# Real email (password reset, claim invites/approvals — see
# apps/api/src/lib/email.ts) needs a Resend API key in production; without
# one, these flows safely no-op instead of sending mail. Get a key at
# https://resend.com and verify a domain before sending real production
# mail (the default RESEND_FROM_EMAIL below is Resend's shared testing
# sender, fine for a quick check but not for real use).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
